# vim: set ft=zsh:

alias l:ports="sudo lsof -i -P -n | grep LISTEN"
alias lg="lazygit"
alias ls="ls --color=auto"
alias diff="diff --color=auto"
alias u="util"
alias m="make"

alias 1="z -1"
alias 2="z -2"
alias 3="z -3"
alias 4="z -4"
alias 5="z -5"
alias 6="z -6"
alias 7="z -7"
alias 8="z -8"
alias 9="z -9"
